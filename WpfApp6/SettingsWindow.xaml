<Window x:Class="WpfApp6.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Height="300" Width="400"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20">
        <TextBlock Text="Цвет фона главного окна:" FontWeight="Bold"/>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,15">
            <Button Content="розовый" Click="BtnRed_Click" Width="80" Margin="0,0,5,0"/>
            <Button Content="Зеленый" Click="BtnGreen_Click" Width="80" Margin="0,0,5,0"/>
            <Button Content="Синий" Click="BtnBlue_Click" Width="80" Margin="0,0,5,0"/>
            <Button  Content="Белый" Click="BtnWhite_Click" Width="80"/>
        </StackPanel>

        <TextBlock Text="Ширина окна:" FontWeight="Bold"/>
        <Slider x:Name="WidthSlider" Minimum="300" Maximum="1000" Value="600" 
                ValueChanged="WidthSlider_ValueChanged" Margin="0,5,0,15"/>

        <TextBlock Text="Высота окна:" FontWeight="Bold"/>
        <Slider x:Name="HeightSlider" Minimum="200" Maximum="800" Value="400" 
                ValueChanged="HeightSlider_ValueChanged" Margin="0,5,0,15"/>
    </StackPanel>
</Window>